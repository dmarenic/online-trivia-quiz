# Baza podataka.
# Kod pokretanja preko docker-compose.yml host je naziv servisa "postgres",
# a korisnik/lozinka/baza moraju odgovarati POSTGRES_* vrijednostima niže:
# DATABASE_URL="postgresql://trivia:promijeni-me@postgres:5432/trivia?schema=public"
# DIRECT_URL="postgresql://trivia:promijeni-me@postgres:5432/trivia?schema=public"
DATABASE_URL=""
DIRECT_URL=""

# Koristi ih postgres servis iz docker-compose.yml.
POSTGRES_USER="trivia"
POSTGRES_PASSWORD="promijeni-me"
POSTGRES_DB="trivia"

JWT_SECRET=""

JWT_EXPIRES_IN="7d"

FRONTEND_URL=""

GEMINI_API_KEY=""