generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model GameResult {
  id             String   @id @default(cuid())
  nickname       String
  score          Int
  correctAnswers Int      @default(0)
  totalQuestions Int      @default(0)
  createdAt      DateTime @default(now())
  mode           String   @default("normal")

  userId String?
  user   User?   @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([createdAt])
  @@index([mode])
}

model Question {
  id            String   @id @default(cuid())
  category      String
  difficulty    String   @default("medium")
  question      String
  optionA       String
  optionB       String
  optionC       String
  optionD       String
  correctAnswer String
  createdAt     DateTime @default(now())

  @@unique([category, question])
  @@index([category])
  @@index([difficulty])
}

model User {
  id        String   @id @default(cuid())
  username  String   @unique
  email     String   @unique
  password  String
  avatar    String?  @default("default")
  createdAt DateTime @default(now())

  results GameResult[]

  sentFriends     Friend[] @relation("FriendSender")
  receivedFriends Friend[] @relation("FriendReceiver")

  dailyChallengeAttempts DailyChallengeAttempt[]

  sentRoomInvites     RoomInvite[] @relation("SentRoomInvites")
  receivedRoomInvites RoomInvite[] @relation("ReceivedRoomInvites")

  role String @default("USER")
}

model Friend {
  id         String   @id @default(cuid())
  senderId   String
  receiverId String
  status     String   @default("pending")
  createdAt  DateTime @default(now())

  sender   User @relation("FriendSender", fields: [senderId], references: [id])
  receiver User @relation("FriendReceiver", fields: [receiverId], references: [id])

  @@unique([senderId, receiverId])
}

model DailyChallenge {
  id            String   @id @default(cuid())
  title         String
  description   String
  targetScore   Int
  date          String   @unique
  createdAt     DateTime @default(now())
  category      String   @default("Sport")
  questionCount Int      @default(5)

  attempts DailyChallengeAttempt[]
}

// Pravilo "jedan pokušaj dnevno" nije samo aplikacijska provjera: @@unique
// ispod ga podiže na razinu baze, pa ga ni istovremeni zahtjevi ni greška u
// kodu ne mogu zaobići (v. transakciju u daily-challenge.controller.ts).
model DailyChallengeAttempt {
  id             String   @id @default(cuid())
  userId         String
  challengeId    String
  score          Int
  correctAnswers Int
  totalQuestions Int
  completed      Boolean  @default(false)
  createdAt      DateTime @default(now())

  user      User           @relation(fields: [userId], references: [id])
  challenge DailyChallenge @relation(fields: [challengeId], references: [id])

  @@unique([userId, challengeId])
  @@index([userId])
  @@index([challengeId])
}

model RoomInvite {
  id         String   @id @default(cuid())
  roomCode   String
  fromUserId String
  toUserId   String
  createdAt  DateTime @default(now())

  fromUser User @relation("SentRoomInvites", fields: [fromUserId], references: [id])
  toUser   User @relation("ReceivedRoomInvites", fields: [toUserId], references: [id])

  @@index([toUserId])
  @@index([fromUserId])
  @@index([roomCode])
}
